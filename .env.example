# Copy to .env and fill values. Never commit real secrets.
PORT=3001
# Frontend gọi backend qua proxy Vite (/api -> VITE_API_PROXY). Đổi cổng backend thì sửa cả 2.
VITE_API_PROXY=http://localhost:3001
VITE_API_URL=http://localhost:3001
VITE_GEMINI_API_KEY=
JWT_ACCESS_TTL_MIN=15
AI_PROVIDER=stub

# Hạn mức rate limit mỗi phút cho một IP (mặc định 300 công khai / 30 nhạy cảm).
# Nới ra hoặc đặt 0 để tắt khi chạy bộ kiểm thử: npm run check:backend
DMS_RATE_LIMIT_PUBLIC=300
DMS_RATE_LIMIT_SENSITIVE=30
# Đặt 1 để tắt hoàn toàn rate limit (chỉ dùng khi kiểm thử, không dùng production).
DMS_DISABLE_RATE_LIMIT=0
